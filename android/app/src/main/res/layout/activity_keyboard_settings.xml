<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootKeyboardSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_modern" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keyboard Settings"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card"
                android:elevation="4dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- AI Preferences -->
                <LinearLayout
                    android:id="@+id/rowAiPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/app_logo"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Preferences"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Theme -->
                <LinearLayout
                    android:id="@+id/rowTheme"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_kb_palette"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Language -->
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_translate"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Keyboard layout -->
                <LinearLayout
                    android:id="@+id/rowLayout"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_grid"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keyboard layout"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                </LinearLayout>
                
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Word suggestions -->
                <LinearLayout
                    android:id="@+id/rowSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_text_edit"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Word suggestions"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                        
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSuggestions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
        app:thumbTint="#7B1FA2"
        app:trackTint="#D1C4E9"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Summarise and Reply -->
                <LinearLayout
                    android:id="@+id/rowSummariseReply"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/app_logo"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Summarise and Reply on selection"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                        
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSummariseReply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
        app:thumbTint="#7B1FA2"
        app:trackTint="#D1C4E9"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Auto-correction -->
                <LinearLayout
                    android:id="@+id/rowAutoCorrection"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wand"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Auto-correction"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                        
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoCorrection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
        app:thumbTint="#7B1FA2"
        app:trackTint="#D1C4E9"/>
                </LinearLayout>
                
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Swipe/Finger typing -->
                <LinearLayout
                    android:id="@+id/rowSwipeTyping"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_kb_recent"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Swipe/Finger typing"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                        
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSwipeTyping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
        app:thumbTint="#7B1FA2"
        app:trackTint="#D1C4E9"/>
                </LinearLayout>
                
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA" android:layout_marginHorizontal="12dp"/>

                <!-- Other keyboard preferences -->
                <LinearLayout
                    android:id="@+id/rowPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="12dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_kb_settings"
                        android:layout_marginEnd="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other keyboard preferences"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
