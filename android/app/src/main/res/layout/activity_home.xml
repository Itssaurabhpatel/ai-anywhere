<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_purple_wave"
    android:theme="@style/Theme.AiEverywhere">

    <ScrollView android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingTop="80dp" android:paddingBottom="8dp">

            <!-- Greeting Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp">

                <!-- Line 1: Hi {name} -->
                <TextView
                    android:id="@+id/tvGreetingName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, User 👋"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    app:fontFamily="@font/poppins"
                    android:textColor="#1A1A1A"
                    android:alpha="0.65"
                    android:layout_marginBottom="-2dp"/>

                <!-- Line 2: Welcome to -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to"
                    android:textSize="26sp"
                    android:fontFamily="@font/poppins"
                    app:fontFamily="@font/poppins"
                    android:textColor="#1A1A1A"
                    android:layout_marginTop="0dp"/>

                <!-- Line 3: Animated Logo + App Name -->
                <LinearLayout
                    android:id="@+id/llAppBranding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:id="@+id/ivBrandLogo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/app_logo"
                        android:background="@drawable/shape_circle_white"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvBrandName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI anyWhere"
                        android:textSize="28sp"
                        android:fontFamily="@font/poppins"
                        app:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Banner Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/top_header_img"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"/>
            </androidx.cardview.widget.CardView>

            <!-- AI Integration Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Integration"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                app:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAiIntegration"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:id="@+id/layoutAiContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <!-- Left: AI Provider Logo -->
                    <ImageView
                        android:id="@+id/ivAiProviderLogo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_openai"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginEnd="14dp"/>

                    <!-- Right: Name + Subheading -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAiUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OpenAI"
                            android:textSize="18sp"
                            android:fontFamily="@font/poppins"
                            app:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:id="@+id/tvAiModelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gemini 1.5 Flash | User for"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"
                            app:fontFamily="@font/poppins"
                            android:textColor="#8E8E93"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Core Features Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Core Features"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                app:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Feature Tile 1: Grammar -->
                <LinearLayout
                    android:id="@+id/tileGrammar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_marginEnd="10dp">
                    
                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_core_grammar"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grammar"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        app:fontFamily="@font/poppins"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Feature Tile 2: Tone -->
                <LinearLayout
                    android:id="@+id/tileTone"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_marginEnd="10dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_core_tone"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tone"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        app:fontFamily="@font/poppins"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Feature Tile 3: Translate -->
                <LinearLayout
                    android:id="@+id/tileTranslate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_marginEnd="10dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_core_translate"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translate"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        app:fontFamily="@font/poppins"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Feature Tile 4: Ask AI -->
                <LinearLayout
                    android:id="@+id/tileAskAi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_core_ask"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ask Ai"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        app:fontFamily="@font/poppins"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Privacy First Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_privacy_shield"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privacy First"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your data is safe and kept strictly on your device."
                            android:textSize="12sp"
                            android:textColor="#8E8E93"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemTextAppearanceInactive="@style/BottomNavTextAppearanceInactive"
        app:itemTextAppearanceActive="@style/BottomNavTextAppearanceActive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
