<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@null">

        <ImageButton
            android:id="@+id/btn_text_edit_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_modern"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text Editing"
            android:textColor="#1C1C1E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_edit_select_all"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Select All"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_key_normal"
            android:textColor="#1C1C1E"
            android:elevation="1dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_edit_cut"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Cut"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_key_normal"
            android:textColor="#1C1C1E"
            android:elevation="1dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_edit_copy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Copy"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_key_normal"
            android:textColor="#1C1C1E"
            android:elevation="1dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_edit_paste"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Paste"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_key_normal"
            android:textColor="#1C1C1E"
            android:elevation="1dp" />
    </LinearLayout>

    <!-- D-Pad Navigation and Editing Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- D-Pad Arrows -->
        <GridLayout
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <View android:layout_width="48dp" android:layout_height="48dp" />
            <Button
                android:id="@+id/btn_arrow_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="â–²"
                android:textSize="18sp"
                android:background="@drawable/bg_key_special"
                android:textColor="#1C1C1E"
                android:elevation="2dp" />
            <View android:layout_width="48dp" android:layout_height="48dp" />

            <Button
                android:id="@+id/btn_arrow_left"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="â—„"
                android:textSize="18sp"
                android:background="@drawable/bg_key_special"
                android:textColor="#1C1C1E"
                android:elevation="2dp" />
            <Button
                android:id="@+id/btn_edit_select_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="Select"
                android:textSize="10sp"
                android:background="@drawable/bg_gradient_yellow"
                android:textColor="#1C1C1E"
                android:elevation="2dp" />
            <Button
                android:id="@+id/btn_arrow_right"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="â–º"
                android:textSize="18sp"
                android:background="@drawable/bg_key_special"
                android:textColor="#1C1C1E"
                android:elevation="2dp" />

            <View android:layout_width="48dp" android:layout_height="48dp" />
            <Button
                android:id="@+id/btn_arrow_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="â–¼"
                android:textSize="18sp"
                android:background="@drawable/bg_key_special"
                android:textColor="#1C1C1E"
                android:elevation="2dp" />
            <View android:layout_width="48dp" android:layout_height="48dp" />
        </GridLayout>

        <!-- Quick Jump Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp">

            <Button
                android:id="@+id/btn_jump_start"
                android:layout_width="90dp"
                android:layout_height="42dp"
                android:text="Start"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_key_normal"
                android:textColor="#1C1C1E"
                android:elevation="1dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_jump_end"
                android:layout_width="90dp"
                android:layout_height="42dp"
                android:text="End"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_key_normal"
                android:textColor="#1C1C1E"
                android:elevation="1dp"
                android:layout_marginBottom="8dp" />

            <ImageButton
                android:id="@+id/btn_edit_backspace"
                android:layout_width="90dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_backspace"
                android:background="@drawable/bg_key_special"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:elevation="1dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
