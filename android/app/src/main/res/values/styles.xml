<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AiEverywhere" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">#FFFFFF</item>
        <item name="colorAccent">#7B1FA2</item>
        <item name="colorSecondary">#7B1FA2</item>
        <item name="colorControlActivated">#7B1FA2</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textViewStyle">@style/PoppinsTextView</item>
        <item name="bottomNavigationStyle">@style/Widget.AiEverywhere.BottomNavigationView</item>
    </style>

    <style name="PoppinsTextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Widget.AiEverywhere.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceInactive">@style/BottomNavTextAppearanceInactive</item>
        <item name="itemTextAppearanceActive">@style/BottomNavTextAppearanceActive</item>
    </style>

    <style name="BottomNavTextAppearanceInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BottomNavTextAppearanceActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeyButton" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/bg_key_normal</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">22sp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyButtonSpecial" parent="KeyButton">
        <item name="android:background">@drawable/bg_key_special</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
